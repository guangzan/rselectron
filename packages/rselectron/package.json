{
  "name": "@rselectron/core",
  "version": "1.0.0-beta.13",
  "description": "An Rspack-first Electron development and build tool.",
  "keywords": [
    "electron",
    "rsbuild",
    "rspack",
    "build-tool",
    "dev-tool"
  ],
  "homepage": "https://guangzan.github.io/rselectron/",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guangzan/rselectron.git"
  },
  "bin": {
    "rselectron": "./bin/rselectron.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./node.d.ts"
    }
  },
  "files": [
    "bin",
    "dist",
    "node.d.ts"
  ],
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "electron": ">=28 <44"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
