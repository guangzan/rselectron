{
  "name": "rselectron-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "corepack pnpm --filter rselectron build",
    "bench": "node --experimental-strip-types scripts/benchmarks/run.mjs",
    "bench:check": "node --experimental-strip-types scripts/benchmarks/check.mjs",
    "docs:build": "corepack pnpm --filter @rselectron/website build",
    "docs:dev": "corepack pnpm --filter @rselectron/website dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "rslint .",
    "release:publish": "corepack pnpm exec changeset publish",
    "test": "rstest",
    "test:unit": "rstest tests/unit",
    "test:docs": "rstest tests/docs",
    "test:integration": "rstest tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "rslint --type-check-only ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "7.58.12",
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "2.1.7",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "0.7.0",
    "@rstest/core": "^0.11.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "43.2.0",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
