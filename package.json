{
  "name": "rselectron-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "corepack pnpm --filter \"@rselectron/core\" build",
    "bench": "node --experimental-strip-types scripts/benchmarks/run.mjs",
    "bench:check": "node --experimental-strip-types scripts/benchmarks/check.mjs",
    "docs:build": "corepack pnpm --filter @rselectron/website build",
    "docs:dev": "corepack pnpm --filter @rselectron/website dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "rslint .",
    "prepare": "simple-git-hooks",
    "release": "tsx scripts/release.ts",
    "publish-ci": "tsx scripts/publish-ci.ts",
    "test": "rstest",
    "test:unit": "rstest tests/unit",
    "test:docs": "rstest tests/docs",
    "test:integration": "rstest tests/integration",
    "test:e2e": "playwright test",
    "typecheck": "rslint --type-check-only ."
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.12",
    "@playwright/test": "^1.61.1",
    "@rsbuild/core": "2.1.7",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rslib/core": "^0.23.2",
    "@rslint/core": "0.7.0",
    "@rstest/core": "^0.11.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bumpp": "^10.4.1",
    "electron": "43.2.0",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "zx": "^8.8.5"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  }
}
