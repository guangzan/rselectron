{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@rselectron-internal/cli": ["./packages/cli/src/index.ts"],
      "@rselectron-internal/core": ["./packages/core/src/index.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
